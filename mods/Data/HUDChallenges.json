	"_comment_formats": "Formats accept: Challenges (daily, weekly, events, seasonal, character, survival, combat, social, world, fishing, burning_springs) | Events (mutatedEvent, publicEvent, worldEvent, caravan) | Challenges accept {text}, {currentValue}, {thresholdValue}, {endTime} | Events accept {text}, {time} | mutatedEvent accepts {mutation} | mutatedEvent and publicEvent accept {participants} | showSeasonEndTime accepts {time} | showRaidXP accepts {xp}",
	"formats": {
		"daily": "{text} {currentValue}/{thresholdValue}",
		"weekly": "{text} {currentValue}/{thresholdValue}",
		"monthly": "{text} {currentValue}/{thresholdValue}",
		"events": "{text} {currentValue}/{thresholdValue} ({endTime})",
		"seasonal": "{text} {currentValue}/{thresholdValue}",
		"character": "{text} {currentValue}/{thresholdValue}",
		"survival": "{text} {currentValue}/{thresholdValue}",
		"combat": "{text} {currentValue}/{thresholdValue}",
		"social": "{text} {currentValue}/{thresholdValue}",
		"world": "{text} {currentValue}/{thresholdValue}",
		"fishing": "{text} {currentValue}/{thresholdValue}",
		"burning_springs": "{text} [{currentValue}/{thresholdValue}]",
		
		"mutatedEvent": "[M][{participants}] {text} [{mutation}] {time}",
		"publicEvent": "[P][{participants}] {text} {time}",
		"worldEvent": "[W] {text} {time}",
		"caravan": "[C] {text} {time}",
		
		"showSeasonEndTime": "Season end: {time}",
		"showRaidXP": "Raid XP: {xp}",
		
		"timeLong": "{d}:{h}:{m}:{s}",
		"timeMid": "{h}:{m}:{s}",
		"timeShort": "{m}:{s}"
	},
	
	"_comment_xpBar": "text accepts: {text}, {currentLevel}, {progress}, {lastChangeValue}, {currentValue}, {thresholdValue}",
	"xpBar": {
		"enabled": true,
		"text": "{text} [{currentLevel}] {progress}% ({lastChangeValue})",
		"alignVertical": "center",
		"alignHorizontal": "right",
		"height": 20
	},
	
	"_comment_scoreBar": "text accepts: {progress}, {currentValue}, {thresholdValue}, {currentRank}, {currentBoost}",
	"scoreBar": {
